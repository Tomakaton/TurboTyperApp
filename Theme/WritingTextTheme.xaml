<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enums="clr-namespace:TurboTyper.MVVM.ViewModel.Enums">

    <Style x:Key="WordBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="BorderThickness" Value="0,0,2,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCaretAtWordEnd}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CharBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Margin" Value="-2,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CharTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontFamily" Value="{StaticResource CascadiaMonoFont}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static enums:CharacterState.Correct}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static enums:CharacterState.Incorrect}">
                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static enums:CharacterState.Skipped}">
                <Setter Property="Foreground" Value="{StaticResource SkippedRedBrush}"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
