<UserControl x:Class="TurboTyper.MVVM.View.UserControls.GameSettingsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TurboTyper.MVVM.ViewModel"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameSessionViewModel}"
             d:DesignHeight="160" d:DesignWidth="960">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Settings"
                       FontSize="40"
                       FontFamily="{StaticResource LexendFont}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Main Menu"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding HomeCommand}"
                    Focusable="False"
                    FontSize="15"
                    Padding="16,8"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="10"
                    Background="{StaticResource BgSecondaryBrush}"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0"
                                     Content="Time"
                                     HorizontalAlignment="Stretch"
                                     Focusable="False"
                                     Style="{StaticResource SettingButton}"
                                     IsChecked="{Binding Settings.Mode, Converter={StaticResource RadioEnumToBooleanConverter}, ConverterParameter=Time}"
                                     GroupName="Mode"/>
                        <RadioButton Grid.Column="1"
                                     Content="Words"
                                     HorizontalAlignment="Stretch"
                                     Focusable="False"
                                     Style="{StaticResource SettingButton}"
                                     IsChecked="{Binding Settings.Mode, Converter={StaticResource RadioEnumToBooleanConverter}, ConverterParameter=Words}"
                                     GroupName="Mode"/>
                    </Grid>

                    <Rectangle Grid.Column="1"
                               Width="2"
                               Fill="{StaticResource BorderMutedBrush}"
                               VerticalAlignment="Stretch"
                               Margin="12,12"/>

                    <ItemsControl Grid.Column="2"
                                  ItemsSource="{Binding Settings.Difficulties}"
                                  HorizontalAlignment="Stretch"
                                  Focusable="False"
                                  Style="{StaticResource DifficultyList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Difficulty"
                                             Focusable="False"
                                             Style="{StaticResource SettingButton}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <RadioButton.Content>
                                        <MultiBinding Converter="{StaticResource DifficultyDisplayConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.Settings.Mode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </RadioButton.Content>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Button Grid.Column="2"
                    Style="{StaticResource RestartButtonStyle}"
                    Command="{Binding RestartCommand}"
                    Focusable="False"
                    ToolTip="Restart Test (Esc)">
                <Image Source="/Images/RestartIcon.png" Width="26" Height="26"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
